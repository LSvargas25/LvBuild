# LvBuild API - environment variables
#
# Copy to .env (git-ignored) for docker compose, or set them in your hosting provider.
# ASP.NET Core maps "__" to the ":" section separator (Jwt__Key -> Jwt:Key).
# Never commit real values.

# --- Required -------------------------------------------------------------------------------

# PostgreSQL connection string. Neon: use the pooled endpoint for the app and add SSL Mode=Require.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=lvbuild;Username=lvbuild;Password=change-me

# HMAC-SHA256 signing key for JWTs: random, at least 32 characters (e.g. `openssl rand -base64 48`).
Jwt__Key=change-me-to-a-random-string-of-at-least-32-characters
Jwt__Issuer=LvConstruccionesApi
Jwt__Audience=LvConstruccionesClient

# --- Optional -------------------------------------------------------------------------------

# Browser origins allowed by CORS (the frontend URL). Add __1, __2, ... for more.
Cors__AllowedOrigins__0=http://localhost:5173

# Apply pending EF Core migrations when the app starts (Render free plan has no pre-deploy hook).
Database__MigrateOnStartup=false

# Load the demo company (idempotent: running it again does not duplicate data).
Seed__Demo=false

# Serve Swagger UI at /swagger outside Development.
Swagger__Enabled=false

# Set to true behind a TLS-terminating proxy (Render): trusts X-Forwarded-* headers and lets the
# proxy enforce HTTPS instead of the app.
ReverseProxy__Enabled=false

# Port to listen on inside the container. Render injects PORT; the image defaults to 8080.
# PORT=8080

# ASPNETCORE_ENVIRONMENT=Production
