<Project>
  <!--
    Centralized analyzer settings for every project in the solution.
    Uses the .NET SDK's built-in analyzers (Microsoft.CodeAnalysis.NetAnalyzers) —
    no extra NuGet package needed, so there is no version to pin/track separately from the SDK.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    The solution builds with 0 warnings. CI (GitHub Actions sets CI=true) keeps it that way by
    failing on any new warning; local builds only warn so work in progress isn't blocked.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
